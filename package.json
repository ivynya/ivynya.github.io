		"@types/tinycolor2": "^1.4.6",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.28.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"type": "module",
	"dependencies": {
		"sass": "^1.69.5",
		"tinycolor2": "^1.6.0"
